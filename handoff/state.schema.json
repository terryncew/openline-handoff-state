{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HANDOFF STATE SCHEMA v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "goal",
    "authority_owner",
    "current_state",
    "frozen_invariants",
    "verified_facts",
    "claims",
    "open_questions",
    "failed_or_superseded_paths",
    "canonical_terms",
    "proposed_state_changes",
    "next_permitted_actions",
    "stop_conditions",
    "identifiers",
    "roles"
  ],
  "properties": {
    "schema": {
      "const": "openline.handoff-state.v0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "current_state": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "frozen_invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "next_permitted_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "verified_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact",
          "evidence"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "basis",
          "ceiling"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "ceiling": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "owner"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "failed_or_superseded_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "classification",
          "evidence"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "classification": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "canonical_terms": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "proposed_state_changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shas",
        "paths",
        "versions",
        "dates",
        "receipts"
      ],
      "properties": {
        "shas": {
          "type": "object"
        },
        "paths": {
          "type": "object"
        },
        "versions": {
          "type": "object"
        },
        "dates": {
          "type": "object"
        },
        "receipts": {
          "type": "object"
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "proposer",
        "verifier",
        "admitter",
        "executor"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "proposer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "admitter": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "executor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
